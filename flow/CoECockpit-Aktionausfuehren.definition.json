{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "coeck_SharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "coeck_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "CoE Cockpit – SharePoint-Website (coeck_CockpitSiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "coeck_CockpitSiteUrl",
            "description": "URL der SharePoint-Website, auf der das CoE Cockpit eingebunden ist und die Liste „CoE Cockpit Aktionen“ liegt, z. B. https://contoso.sharepoint.com/sites/powerplatform"
          }
        },
        "CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)": {
          "defaultValue": "CoE Cockpit Aktionen",
          "type": "String",
          "metadata": {
            "schemaName": "coeck_ActionListName",
            "description": "Titel oder ID der SharePoint-Liste mit den Aufträgen (Standard: CoE Cockpit Aktionen)."
          }
        },
        "CoE Cockpit – SharePoint-Gruppe (coeck_AdminGroupName)": {
          "defaultValue": "CoE Cockpit Admins",
          "type": "String",
          "metadata": {
            "schemaName": "coeck_AdminGroupName",
            "description": "Nur Aufträge von Mitgliedern dieser SharePoint-Gruppe werden ausgeführt (dieselbe Gruppe wie in den Webpart-Eigenschaften, Standard: CoE Cockpit Admins)."
          }
        }
      },
      "triggers": {
        "Wenn_ein_Auftrag_angelegt_wird": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('CoE Cockpit – SharePoint-Website (coeck_CockpitSiteUrl)')",
              "table": "@parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Neuer Auftrag aus dem CoE Cockpit (Liste „CoE Cockpit Aktionen“). Nur Status „Angefordert“ – direkt im Webpart ausgeführte Aktionen stehen schon auf „In Arbeit“.",
          "conditions": [
            {
              "expression": "@or(empty(triggerOutputs()?['body/Status']), equals(triggerOutputs()?['body/Status'], 'Angefordert'))"
            }
          ]
        }
      },
      "actions": {
        "Ergebnis_init": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Ergebnis",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {}
        },
        "Fehler_init": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Fehler",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Ergebnis_init": [
              "Succeeded"
            ]
          }
        },
        "Abgelehnt_init": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Abgelehnt",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Fehler_init": [
              "Succeeded"
            ]
          }
        },
        "Hinweis_init": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Hinweis",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Abgelehnt_init": [
              "Succeeded"
            ]
          }
        },
        "Status_In_Arbeit": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('CoE Cockpit – SharePoint-Website (coeck_CockpitSiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/@{if(equals(length(trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)'))), 36), concat('lists(guid''', trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)')), ''')'), concat('lists/getbytitle(''', replace(trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)')), '''', ''''''), ''')'))}/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata",
                "IF-MATCH": "*",
                "X-HTTP-Method": "MERGE"
              },
              "parameters/body": "{\"Status\": \"In Arbeit\"}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Hinweis_init": [
              "Succeeded"
            ]
          }
        },
        "Ausfuehrung": {
          "type": "Scope",
          "runAfter": {
            "Status_In_Arbeit": [
              "Succeeded",
              "Failed"
            ]
          },
          "actions": {
            "Gruppenmitglieder_lesen": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('CoE Cockpit – SharePoint-Website (coeck_CockpitSiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('@{parameters('CoE Cockpit – SharePoint-Gruppe (coeck_AdminGroupName)')}')/users?$select=LoginName,Email&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Mitglied_pruefen": {
              "type": "Query",
              "runAfter": {
                "Gruppenmitglieder_lesen": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Gruppenmitglieder_lesen')?['value'], body('Gruppenmitglieder_lesen')?['d']?['results'], createArray())",
                "where": "@or(equals(toLower(item()?['LoginName']), toLower(triggerOutputs()?['body/Author/Claims'])), and(not(empty(item()?['Email'])), equals(toLower(item()?['Email']), toLower(triggerOutputs()?['body/Author/Email']))))"
              }
            },
            "Mitgliedschaft": {
              "type": "If",
              "runAfter": {
                "Mitglied_pruefen": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Mitglied_pruefen'))",
                  0
                ]
              },
              "actions": {
                "Aktion": {
                  "type": "Switch",
                  "expression": "@triggerOutputs()?['body/Action']",
                  "cases": {
                    "Fall_soldelete": {
                      "case": "soldelete",
                      "actions": {
                        "Nur_Solution_soldelete": {
                          "type": "If",
                          "expression": {
                            "equals": [
                              "@triggerOutputs()?['body/ResourceType']",
                              "solution"
                            ]
                          },
                          "actions": {
                            "Solution_lesen_soldelete": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "GetItemWithOrganization",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "organization": "@triggerOutputs()?['body/EnvironmentId']",
                                  "entityName": "solutions",
                                  "recordId": "@triggerOutputs()?['body/ResourceId']",
                                  "$select": "uniquename,ismanaged,isvisible"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            },
                            "Solution_lesen_Fehler_soldelete": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "Fehler",
                                "value": "@{coalesce(body('Solution_lesen_soldelete')?['error']?['message'], body('Solution_lesen_soldelete')?['message'], actions('Solution_lesen_soldelete')?['error']?['message'], 'Aktion Solution_lesen_soldelete ist fehlgeschlagen.')}"
                              },
                              "runAfter": {
                                "Solution_lesen_soldelete": [
                                  "Failed",
                                  "TimedOut"
                                ]
                              }
                            },
                            "Loeschen_erlaubt_soldelete": {
                              "type": "If",
                              "runAfter": {
                                "Solution_lesen_soldelete": [
                                  "Succeeded"
                                ]
                              },
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@body('Solution_lesen_soldelete')?['ismanaged']",
                                      false
                                    ]
                                  },
                                  {
                                    "not": {
                                      "contains": [
                                        "@createArray('default','active','basic','system','crmservicesolution')",
                                        "@toLower(coalesce(body('Solution_lesen_soldelete')?['uniquename'], ''))"
                                      ]
                                    }
                                  }
                                ]
                              },
                              "actions": {
                                "Solution_loeschen_soldelete": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_commondataserviceforapps",
                                      "operationId": "DeleteRecordWithOrganization",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                    },
                                    "parameters": {
                                      "organization": "@triggerOutputs()?['body/EnvironmentId']",
                                      "entityName": "solutions",
                                      "recordId": "@triggerOutputs()?['body/ResourceId']"
                                    },
                                    "authentication": "@parameters('$authentication')",
                                    "retryPolicy": {
                                      "type": "exponential",
                                      "count": 4,
                                      "interval": "PT15S"
                                    }
                                  }
                                },
                                "Solution_loeschen_Fehler_soldelete": {
                                  "type": "SetVariable",
                                  "inputs": {
                                    "name": "Fehler",
                                    "value": "@{coalesce(body('Solution_loeschen_soldelete')?['error']?['message'], body('Solution_loeschen_soldelete')?['message'], actions('Solution_loeschen_soldelete')?['error']?['message'], 'Aktion Solution_loeschen_soldelete ist fehlgeschlagen.')}"
                                  },
                                  "runAfter": {
                                    "Solution_loeschen_soldelete": [
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  }
                                },
                                "Ergebnis_setzen_soldelete": {
                                  "type": "SetVariable",
                                  "inputs": {
                                    "name": "Ergebnis",
                                    "value": "Die Solution wurde gelöscht. Ihre Komponenten (Apps, Flows, Tabellen …) bleiben im Environment erhalten."
                                  },
                                  "runAfter": {
                                    "Solution_loeschen_soldelete": [
                                      "Succeeded"
                                    ]
                                  }
                                },
                                "CoE_Solution_geloescht_soldelete": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_commondataserviceforapps",
                                      "operationId": "UpdateRecord",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                    },
                                    "parameters": {
                                      "entityName": "admin_solutions",
                                      "recordId": "@triggerOutputs()?['body/CoeRecordId']",
                                      "item/admin_solutiondeleted": true,
                                      "item/admin_solutiondeletedon": "@utcNow()"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  },
                                  "runAfter": {
                                    "Ergebnis_setzen_soldelete": [
                                      "Succeeded"
                                    ]
                                  }
                                },
                                "CoE_Solution_geloescht_Hinweis_soldelete": {
                                  "type": "AppendToStringVariable",
                                  "inputs": {
                                    "name": "Hinweis",
                                    "value": " (CoE-Inventar nicht aktualisiert: @{coalesce(body('CoE_Solution_geloescht_soldelete')?['error']?['message'], body('CoE_Solution_geloescht_soldelete')?['message'], actions('CoE_Solution_geloescht_soldelete')?['error']?['message'], 'Aktion CoE_Solution_geloescht_soldelete ist fehlgeschlagen.')})"
                                  },
                                  "runAfter": {
                                    "CoE_Solution_geloescht_soldelete": [
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Abgelehnt_verwaltet_soldelete": {
                                    "type": "SetVariable",
                                    "inputs": {
                                      "name": "Abgelehnt",
                                      "value": "Verwaltete Solutions und System-Solutions werden nicht gelöscht (Deinstallation nur über das Admin Center bzw. ALM)."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Abgelehnt_keine_Solution_soldelete": {
                                "type": "SetVariable",
                                "inputs": {
                                  "name": "Abgelehnt",
                                  "value": "Diese Aktion gibt es nur für Solutions."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "default": {
                    "actions": {
                      "Nicht_im_Flow": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "Abgelehnt",
                          "value": "@{concat('Die Aktion „', triggerOutputs()?['body/Action'], '“ führt das CoE Cockpit (ab Version 1.14) direkt aus, nicht dieser Flow. Bitte das Webpart aktualisieren.')}"
                        }
                      }
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Nicht_Mitglied": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Abgelehnt",
                      "value": "@{concat(triggerOutputs()?['body/Author/DisplayName'], ' ist nicht Mitglied der SharePoint-Gruppe „', parameters('CoE Cockpit – SharePoint-Gruppe (coeck_AdminGroupName)'), '“. Der Auftrag wurde nicht ausgeführt.')}"
                    }
                  }
                }
              }
            },
            "Gruppe_nicht_lesbar": {
              "type": "SetVariable",
              "inputs": {
                "name": "Fehler",
                "value": "@{concat('Die SharePoint-Gruppe „', parameters('CoE Cockpit – SharePoint-Gruppe (coeck_AdminGroupName)'), '“ konnte nicht gelesen werden: ', coalesce(body('Gruppenmitglieder_lesen')?['error']?['message'], body('Gruppenmitglieder_lesen')?['odata.error']?['message']?['value'], 'unbekannter Fehler'))}"
              },
              "runAfter": {
                "Gruppenmitglieder_lesen": [
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          }
        },
        "Status_zurueckschreiben": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('CoE Cockpit – SharePoint-Website (coeck_CockpitSiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/@{if(equals(length(trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)'))), 36), concat('lists(guid''', trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)')), ''')'), concat('lists/getbytitle(''', replace(trim(parameters('CoE Cockpit – Name der Aktionsliste (coeck_ActionListName)')), '''', ''''''), ''')'))}/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata",
                "IF-MATCH": "*",
                "X-HTTP-Method": "MERGE"
              },
              "parameters/body": "@string(addProperty(addProperty(addProperty(json('{}'), 'Status', if(not(empty(variables('Abgelehnt'))), 'Abgelehnt', if(not(empty(variables('Fehler'))), 'Fehler', if(empty(variables('Ergebnis')), 'Fehler', 'Erledigt')))), 'Result', if(not(empty(variables('Abgelehnt'))), variables('Abgelehnt'), if(not(empty(variables('Fehler'))), variables('Fehler'), if(empty(variables('Ergebnis')), 'Unerwarteter Fehler im Flow – Details im Ausführungsverlauf von „CoE Cockpit | Aktion ausführen“.', concat(variables('Ergebnis'), variables('Hinweis')))))), 'CompletedAt', utcNow()))"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Ausfuehrung": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}